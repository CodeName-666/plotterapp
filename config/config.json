{

  "imports": [
    "../qml", 
    "../qml/imports", 
    "../qml/content"
  ],
  "interfaces": [
    {
      "type": "Serial",
      "default": {
        "port": "COM1",
        "baud": 9600,
        "size": "8Bit",
        "parity": "None",
        "stop_bits": "1Bit"
      }
    },
    {
      "type": "Telnet",
      "default": {
        "host": "",
        "port": 0
      }
    },
    {
      "type": "Test",
      "default" : {
        "name": "none",
        "color": 0,
        "type": "SINUS"

      }
    }
  ],
  "qml": {
    "serial" : {
       "dataBits" : [
        {"name": "5Bit", "value": 5},
        {"name": "6Bit", "value": 6},
        {"name": "7Bit", "value": 7},
        {"name": "8Bit", "value": 8}
      ],
      "stopBits": [
        {"name": "1Bit",  "value": 1},
        {"name": "1.5Bit","value": 1.5},
        {"name": "2Bit",  "value": 2}
      ],
      "parityBits" : [
        {"name": "None","value": "None"},
        {"name": "EVEN","value": "EVEN"},
        {"name": "ODD","value": "ODD"}
      ]
    }
  }
}