{

  "imports": [
    "../../qml", 
    "../../qml/imports", 
    "../../qml/content"
  ],
  "interfaces": [
    {
      "type": "Serial",
      "default": {
        "port": "COM1",
        "baud": 9600,
        "size": "8Bit",
        "parity": "None",
        "stop_bits": "1Bit"
      }
    },
    {
      "type": "Telnet",
      "default": {
        "host": "localhost",
        "port": 23
      }
    },
    {
      "type": "MQTT",
      "default": {
        "host": "",
        "port": "",
        "rx_topic": "",
        "tx_topic": ""
      }
    },
    {
      "type": "Test",
      "default": {
        "name": "Sinus Test",
        "color": "#ff4444",
        "type": "Sinus"
      }
    }

 
    
  ],
  "qml": {
    "interfaces": [
      "Serial",
      "Telnet",
      "MQTT",
      "Test"
    ]
  },
  
  "logging" : {
    "enabled": 1,
    "console_log": 1,
    "name" : "logfile.log",
    "level": "DEBUG"
  }
}
