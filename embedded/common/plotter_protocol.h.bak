/**
 * @file plotter_protocol.h
 * @brief PlotterApp Communication Protocol Definitions
 *
 * This header defines the data structures and helper functions for
 * communicating with the PlotterApp via Serial, MQTT, or Telnet.
 *
 * Supported Data Formats:
 * 1. JSON with ID, Value, and Timestamp: {"id":0,"value":123.45,"timestamp":1.234}
 * 2. JSON with ID and Value: {"id":0,"value":123.45}
 * 3. Plain number (fallback): 123.45
 *
 * @version 1.0
 * @date 2025-12-10
 */

#ifndef PLOTTER_PROTOCOL_H
#define PLOTTER_PROTOCOL_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @brief Data point structure for plotting
 *
 * Represents a single measurement point to be plotted.
 *
 * @note ID must be in range 0-255
 * @note Each ID represents a different plot line in the chart
 */
typedef struct {
    uint8_t id;          ///< Line ID (0-255): Identifies which plot line this point belongs to
    float value;         ///< Y-axis value: The measurement value
    float timestamp;     ///< X-axis value: Time in seconds (use 0.0 if not needed)
} PlotDataPoint;

/**
 * @brief Configuration for data point formatting
 */
typedef struct {
    uint8_t precision;       ///< Number of decimal places (default: 6)
    uint8_t include_timestamp; ///< 1 = include timestamp, 0 = omit timestamp
} PlotDataConfig;

// Default configuration
#define PLOTTER_DEFAULT_PRECISION 6
#define PLOTTER_INCLUDE_TIMESTAMP 1
#define PLOTTER_OMIT_TIMESTAMP 0

/**
 * @brief Maximum buffer size for formatted JSON string
 *
 * Format: {"id":255,"value":123.456789,"timestamp":123.456789}\n
 * Max length: ~60 characters + safety margin
 */
#define PLOTTER_BUFFER_SIZE 128

/**
 * @brief Format a data point as JSON string with timestamp
 *
 * Creates a JSON string in the format:
 * {"id":0,"value":123.456789,"timestamp":1.234567}\n
 *
 * @param point Pointer to the data point to format
 * @param buffer Output buffer (must be at least PLOTTER_BUFFER_SIZE bytes)
 * @param buffer_size Size of the output buffer
 * @param precision Number of decimal places for floating point values (default: 6)
 * @return Number of characters written (excluding null terminator), or -1 on error
 *
 * @example
 * PlotDataPoint point = {0, 25.5, 1.234};
 * char buffer[PLOTTER_BUFFER_SIZE];
 * int len = plotter_format_json_with_timestamp(&point, buffer, sizeof(buffer), 6);
 * // Result: {"id":0,"value":25.500000,"timestamp":1.234000}\n
 */
int plotter_format_json_with_timestamp(const PlotDataPoint* point,
                                       char* buffer,
                                       size_t buffer_size,
                                       uint8_t precision);

/**
 * @brief Format a data point as JSON string without timestamp
 *
 * Creates a JSON string in the format:
 * {"id":0,"value":123.456789}\n
 *
 * The PlotterApp will automatically generate timestamps for these points.
 *
 * @param id Line ID (0-255)
 * @param value Measurement value
 * @param buffer Output buffer (must be at least PLOTTER_BUFFER_SIZE bytes)
 * @param buffer_size Size of the output buffer
 * @param precision Number of decimal places for floating point values (default: 6)
 * @return Number of characters written (excluding null terminator), or -1 on error
 *
 * @example
 * char buffer[PLOTTER_BUFFER_SIZE];
 * int len = plotter_format_json_no_timestamp(0, 25.5, buffer, sizeof(buffer), 6);
 * // Result: {"id":0,"value":25.500000}\n
 */
int plotter_format_json_no_timestamp(uint8_t id,
                                     float value,
                                     char* buffer,
                                     size_t buffer_size,
                                     uint8_t precision);

/**
 * @brief Format a value as plain text (simple format)
 *
 * Creates a plain text string with just the value.
 * PlotterApp will use ID=0 and auto-generate timestamp.
 *
 * @param value Measurement value
 * @param buffer Output buffer
 * @param buffer_size Size of the output buffer
 * @param precision Number of decimal places
 * @return Number of characters written (excluding null terminator), or -1 on error
 *
 * @warning This format only supports a single plot line (ID=0)
 *
 * @example
 * char buffer[64];
 * int len = plotter_format_plain(25.5, buffer, sizeof(buffer), 6);
 * // Result: 25.500000\n
 */
int plotter_format_plain(float value,
                        char* buffer,
                        size_t buffer_size,
                        uint8_t precision);

/**
 * @brief Validate a data point
 *
 * Checks if a data point has valid values:
 * - ID must be in range 0-255
 * - Value must be a valid float (not NaN or Inf)
 *
 * @param point Pointer to the data point to validate
 * @return 1 if valid, 0 if invalid
 */
int plotter_validate_point(const PlotDataPoint* point);

/**
 * @brief Create a data point with current timestamp
 *
 * Helper function to create a data point with the current time.
 * The timestamp is calculated based on the provided time_ms in milliseconds.
 *
 * @param id Line ID (0-255)
 * @param value Measurement value
 * @param time_ms Current time in milliseconds
 * @return PlotDataPoint structure with timestamp in seconds
 *
 * @example
 * PlotDataPoint point = plotter_create_point(0, 25.5, millis());
 */
PlotDataPoint plotter_create_point(uint8_t id, float value, uint32_t time_ms);

#ifdef __cplusplus
}
#endif

#endif // PLOTTER_PROTOCOL_H
